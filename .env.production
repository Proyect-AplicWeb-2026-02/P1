# Environment: Production
# Description: Environment variables for the production environment.
# Note: This file must NOT be committed to the repository.

# VITE_HARVARD_API_URL is the base URL for the Harvard Art Museums API.
VITE_HARVARD_API_URL="https://api.harvardartmuseums.org"
# VITE_HARVARD_API_KEY is the API key for the Harvard Art Museums API.
VITE_HARVARD_API_KEY=""
# VITE_OBJECT_ENDPOINT_PATH is the path to the object (artwork) endpoint.
VITE_OBJECT_ENDPOINT_PATH="/object"

# VITE_LOGO_API_URL is the base URL for the Logo.dev API.
VITE_LOGO_API_URL="https://img.logo.dev"
# VITE_LOGO_API_KEY is the publishable API key for the Logo.dev API.
VITE_LOGO_API_KEY=""
# VITE_CLIENT_DOMAIN is the domain used to fetch the client's logo via Logo.dev.
VITE_CLIENT_DOMAIN="harvardartmuseums.org"